# Deployment URL: used for canonical, og:url, JSON-LD ids, robots.txt and sitemap.xml.
# Name, title, description and social links live in src/config/portfolio.ts, not here.
VITE_SITE_URL=https://your-domain.com

# EmailJS (public client values — never put the private key here)
VITE_EMAILJS_USER_PUBLIC_KEY=YOUR_PUBLIC_KEY
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
